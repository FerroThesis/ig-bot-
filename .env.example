TELEGRAM_BOT_TOKEN=123456789:YOUR_BOTFATHER_TOKEN
ADMIN_USER_IDS=11111111,22222222
DB_PATH=./ig2tel.db
POLL_INTERVAL_SECONDS=180
MAX_FETCH_ITEMS=8
TMP_DIR=./tmp
LOG_LEVEL=INFO

# Optional free fallback via gallery-dl command
GALLERY_DL_ENABLED=true
GALLERY_DL_PATH=gallery-dl
GALLERY_DL_TIMEOUT_SECONDS=40

# Optional paid fallback when free providers fail
APIFY_TOKEN=
APIFY_ACTOR_ID=instagram-scraper/instagram-profile-posts-scraper
APIFY_TIMEOUT_SECONDS=60